# Server
PORT=5000
NODE_ENV=development

# TiDB Cloud Starter
# Find these in: TiDB Cloud console → your cluster → Connect → Connect With: General
TIDB_HOST=your-cluster.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_user
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=farewell_connect
TIDB_ENABLE_SSL=true

# Path to the CA certificate, relative to the backend project root.
# Download the cert from TiDB Cloud and place it in the certs/ folder.
TIDB_CA_PATH=/certs/isrgrootx1.pem

# JWT (reserved for authentication phase)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000
